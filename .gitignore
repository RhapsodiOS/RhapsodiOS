# macOS Finder special file
.DS_Store

# Python bytecode: regenerated on every run of the tooling, not source
__pycache__/
*.pyc

# vm directory: large binaries and generated images, not source
vm/*.vmdk
vm/*.img
vm/*.iso
vm/work/
vm/logs/
vm/artifacts/
vm/debs/
vm/shots-*/
vm/capture_output/

# binrecon: analyzer output is generated evidence, not source
tools/binrecon/out/
# Rebuilt driver artifacts staged from the Rhapsody guest; never committed.
out/
# binrecon ledger lock files: transient, never committed
ledger.json.lock
**/reconstruction/*.lock
