{
    CURRENTLY_ACTIVE_VERSION = YES;
    DYNAMIC_CODE_GEN = YES;
    FILESTABLE = {
        FRAMEWORKS = (AppKit.framework, Foundation.framework);
        H_FILES = (Process.h, ProcessType.h, ProcessTableView.h, ProcessControl.h, Inspector.h, InspectorLayout.h);
        MFILES = (Process.m, UserIdCache.m, ProcessType.m, ProcessTableView.m, ProcessControl.m, Inspector.m);
        GLOBAL_RESOURCES = (Resources/ascend.tiff, Resources/descend.tiff, Resources/BuiltIn.processType, Resources/ProcessViewer.tiff, Resources/Info-nextstep.plist);
        English_RESOURCES = (
            ../Resources/English.lproj/BuiltIn.processType.strings,
            ../Resources/English.lproj/Credits.rtf,
            ../Resources/English.lproj/Localizable.strings,
            ../Resources/English.lproj/ProcessViewer.nib/classes.nib,
            ../Resources/English.lproj/ProcessViewer.nib/objects.nib,
            ../Resources/English.lproj/ProcessViewer.nib/NSAppleMenuImage.tiff,
            ../Resources/English.lproj/inspector.nib/classes.nib,
            ../Resources/English.lproj/inspector.nib/objects.nib
        );
        OTHER_SOURCES = (Makefile, Makefile.preamble, Makefile.postamble, PB.project);
    };
    LANGUAGE = English;
    LOCALIZABLE_FILES = {};
    MAKEFILEDIR = "$(MAKEFILEPATH)/pb_makefiles";
    NEXTSTEP_BUILDTOOL = /bin/gnumake;
    NEXTSTEP_INSTALLDIR = /Local/Applications;
    NEXTSTEP_OBJCPLUS_COMPILER = /usr/bin/cc;
    PDO_UNIX_BUILDTOOL = $NEXT_ROOT/Developer/bin/make;
    PDO_UNIX_INSTALLDIR = /Local/Applications;
    PDO_UNIX_OBJCPLUS_COMPILER = "$(NEXTDEV_BIN)/gcc";
    PROJECTNAME = ProcessViewer;
    PROJECTTYPE = Application;
    PROJECTVERSION = 2.8;
    WINDOWS_BUILDTOOL = $NEXT_ROOT/Developer/Executables/make;
    WINDOWS_OBJCPLUS_COMPILER = "$(DEVDIR)/gcc";
}
