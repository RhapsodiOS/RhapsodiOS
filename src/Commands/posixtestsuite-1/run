#!/bin/sh
# usage: run [-t secs] [-d workdir] [-r root] [-b baseline] [-u] [path ...]
# Builds, links and runs each Open POSIX test under ptimeout and writes one
# line per test to stdout and Report/results. See README.
usage="usage: run [-t secs] [-d workdir] [-r root] [-b baseline] [-u] [path ...]"
here=`dirname $0`
here=`cd $here && pwd`
secs=240
work=
root=$here/posixtestsuite
base=$here/baseline
update=0
while test $# -gt 0; do
	case $1 in
	-t|-d|-r|-b) test $# -gt 1 || { echo "$usage" >&2; exit 2; }
		case $1 in
		-t) secs=$2 ;; -d) work=$2 ;; -r) root=$2 ;; -b) base=$2 ;;
		esac
		shift 2 ;;
	-u) update=1; shift ;;
	-*) echo "$usage" >&2; exit 2 ;;
	*) break ;;
	esac
done
test $# -gt 0 || set conformance
expr "$secs" : '[1-9][0-9]*$' >/dev/null || { echo "run: bad -t $secs" >&2; exit 2; }
test $update = 1 || test -r "$base" || { echo "run: no baseline $base" >&2; exit 2; }
cc -v >/dev/null 2>&1 || { echo "run: no cc" >&2; exit 2; }
root=`cd $root && pwd` || { echo "run: no suite root" >&2; exit 2; }
for a in "$@"; do
	(cd "$root" && test -e "$a") || { echo "run: no such test path $a" >&2; exit 2; }
done
# Scratch lives in its own directory, so -d DIR never loses what DIR holds.
test -n "$work" || work=/tmp
mkdir -p $work || { echo "run: cannot create $work" >&2; exit 2; }
work=$work/posix.$$
mkdir $work || { echo "run: cannot create $work" >&2; exit 2; }
trap 'rm -rf $work' 0
trap 'exit 2' 1 2 15
report=`pwd`/Report
rm -rf $report
mkdir -p $report/log
: >$report/results
flags="-O -Wall -D_POSIX_C_SOURCE=200112L -I$root/include"

# result status: the result word for a ptimeout exit status
result() {
	case $1 in
	0) echo PASS ;; 1) echo FAIL ;; 2) echo UNRESOLVED ;;
	4) echo UNSUPPORTED ;; 5) echo UNTESTED ;; 124) echo HUNG ;;
	129|1[3-5][0-9]) echo SIGNAL=`expr $1 - 128` ;;
	*) echo EXIT=$1 ;;
	esac
}

(cd $root && find "$@" \( -name '[0-9]*-*.c' -o -name '[0-9]*-[0-9]*.sh' \) -print) |
	sed -e 's|^\./||' -e 's|//*|/|g' | sort -u >$work/all
# As upstream, a build-only test with a main is linked to <path>.test under
# $bin, a mirror of the suite root where .sh tests run, since some of them
# run those binaries by path. So build-only tests go first.
bin=$work/root
grep -e '-buildonly' $work/all >$work/list
grep -v -e '-buildonly' $work/all >>$work/list
# Every command in the loop reads /dev/null, never the list.
while read f; do
	p=`expr "$f" : '\(.*\)\.[a-z]*$'`
	w=$work/t
	log=$report/log/$p.log
	mkdir -p $w `dirname $log`
	case $f in
	*.c)
		# This sh negates only the first command of a "! a | b" pipeline.
		hasmain=0
		if cc $flags -c $root/$f -o $w/t.o </dev/null >$log 2>&1; then
			nm -g $w/t.o </dev/null 2>>$log | grep ' T _main$' >/dev/null && hasmain=1
			ok=1
		else
			ok=0
		fi
		if test $ok = 0; then
			r=BUILD-FAIL
		elif test $hasmain = 0; then
			r=BUILD-ONLY
		elif expr "$p" : '.*-buildonly' >/dev/null; then
			mkdir -p `dirname $bin/$p`
			r=BUILD-ONLY
			cc -o $bin/$p.test $w/t.o </dev/null >>$log 2>&1 || r=LINK-FAIL
		elif ! cc -o $w/t $w/t.o </dev/null >>$log 2>&1; then
			r=LINK-FAIL
		else
			(cd $w && $here/ptimeout $secs ./t </dev/null >>$log 2>&1)
			r=`result $?`
		fi ;;
	*.sh)
		mkdir -p $bin
		(cd $bin && $here/ptimeout $secs /bin/sh $root/$f </dev/null >$log 2>&1)
		r=`result $?` ;;
	esac
	rm -rf $w
	echo "POSIX $p $r"
	echo "POSIX $p $r" >>$report/results
done <$work/list
sed 's/^POSIX //' $report/results | sort >$work/cur
# baseline.new is the baseline with this run's results merged in: tests not
# run keep their entry, and FLAKY marks survive.
if test -r "$base"; then grep -v '^[ 	]*$' "$base" | sort >$work/base; else : >$work/base; fi
awk 'FNR == NR { old[$1] = $2; next }
	{ print $1, ($1 in old && old[$1] == "FLAKY") ? "FLAKY" : $2; seen[$1] = 1 }
	END { for (k in old) if (!(k in seen)) print k, old[k] }' $work/base $work/cur |
	sort >$report/baseline.new

# Summary. Fields are compared with join and awk, never grep, so a path
# is only ever matched whole.
sum=$report/summary
echo "== counts" >$sum
awk '{ print $3 }' $report/results | sort | uniq -c | awk '{ print "  " $1 " " $2 }' >>$sum
echo "== build failures by family" >>$sum
awk '$3 == "BUILD-FAIL" || $3 == "LINK-FAIL" { split($2, a, "/"); f = a[3]; sub(/_.*/, "", f); print f }' 	$report/results | sort | uniq -c | awk '{ print "  " $1 " " $2 }' >>$sum
if test $update = 1; then
	cp $report/baseline.new "$base"
	exit 0
fi
join $work/cur $work/base >$work/both
for kind in regressions improvements changes; do
	echo "== $kind" >>$sum
	awk -v kind=$kind '$3 != "FLAKY" && $2 != $3 {
		k = $3 == "PASS" ? "regressions" : $2 == "PASS" ? "improvements" : "changes"
		if (k == kind) print "  " $1 " " $3 " -> " $2 }' $work/both >>$sum
done
echo "== new" >>$sum
join -v1 $work/cur $work/base | awk '{ print "  " $1 " " $2 }' >>$sum
rc=0
test `sed -n '/^== regressions/,/^== improvements/p' $sum | grep -c '^  '` = 0 || rc=1
exit $rc
