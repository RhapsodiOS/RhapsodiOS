{
    BUNDLE_EXTENSION = config;
    DYNAMIC_CODE_GEN = YES;
    FILESTABLE = {
        CLASSES = (EtherLinkXLInspector.m);
        FRAMEWORKS = (appkit.framework);
        FRAMEWORKSEARCH = ("$(SYSTEM_LIBRARY_DIR)/PrivateFrameworks", /System/Library/PrivateFrameworks);
        H_FILES = (EtherLinkXLInspector.h);
        OTHER_RESOURCES = (Default.table, 3C905.table, Localizable.strings, 3C905.strings, DriverHelp);
        OTHER_SOURCES = (Makefile.preamble, Makefile, Makefile.postamble, m.template, h.template);
        SUBPROJECTS = (EtherLinkXL.lksproj);
    };
    LANGUAGE = English;
    LOCALIZABLE_FILES = {
        DriverHelp = DriverHelp;
        EtherLinkXLInspector.nib = EtherLinkXLInspector.nib;
        Localizable.strings = Localizable.strings;
        3C905.strings = 3C905.strings;
    };
    MAKEFILEDIR = "$(MAKEFILEPATH)/pb_makefiles";
    NEXTSTEP_BUILDTOOL = /bin/gnumake;
    NEXTSTEP_INSTALLDIR = "$(NEXT_ROOT)/private/Drivers";
    NEXTSTEP_JAVA_COMPILER = /usr/bin/javac;
    NEXTSTEP_OBJCPLUS_COMPILER = /usr/bin/cc;
    PDO_UNIX_JAVA_COMPILER = "$(NEXTDEV_BIN)/javac";
    PDO_UNIX_OBJCPLUS_COMPILER = "$(NEXTDEV_BIN)/gcc";
    PROJECTNAME = EtherLinkXL;
    PROJECTTYPE = Driver;
    PROJECTVERSION = 5.01;
    WINDOWS_JAVA_COMPILER = "$(JDKBINDIR)/javac.exe";
    WINDOWS_OBJCPLUS_COMPILER = "$(DEVDIR)/gcc";
}
