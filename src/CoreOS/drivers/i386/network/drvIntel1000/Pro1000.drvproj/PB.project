{
    BUNDLE_EXTENSION = config;
    DYNAMIC_CODE_GEN = YES;
    FILESTABLE = {
        FRAMEWORKS = ();
        FRAMEWORKSEARCH = ("$(SYSTEM_LIBRARY_DIR)/PrivateFrameworks");
        OTHER_RESOURCES = (Default.table, Instance0.table, Localizable.strings);
        OTHER_SOURCES = (Makefile.preamble, Makefile, Makefile.postamble, DriverInfo);
        SUBPROJECTS = (Pro1000.lksproj);
    };
    LANGUAGE = English;
    LOCALIZABLE_FILES = {};
    MAKEFILEDIR = "$(MAKEFILEPATH)/pb_makefiles";
    NEXTSTEP_BUILDTOOL = /bin/gnumake;
    NEXTSTEP_INSTALLDIR = "$(NEXT_ROOT)/private/Drivers";
    PROJECTNAME = Pro1000;
    PROJECTTYPE = Driver;
    PROJECTVERSION = 1.1;
}
