config = DEBUG
manifest = build-ppc-debug.ninja
ident = -DNEXT -DTIMEZONE="0" -DPST="0" -DINET -DMACH -DNO_DIRECT_RPC -DNETAT -DDEBUG
driver_library = libDriver_kern.o
ddm_object = $outdir/ddm.o
xpr_object = $outdir/xpr.o
include ninja/ppc.ninja

build debug_objects: phony $outdir/ddm.o $outdir/xpr.o
