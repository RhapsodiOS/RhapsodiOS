##
# /etc/hostconfig
##
# This file in maintained by the system control panels
##

# Network configuration
HOSTNAME=-AUTOMATIC-
ROUTER=-AUTOMATIC-

# Services
AFPSERVER=-NO-
APPLETALK=-NO-
AUTODISKMOUNT=-YES-
AUTOMOUNT=-NO-
CONFIGSERVER=-NO-
IPFORWARDING=-NO-
MAILSERVER=-NO-
MANAGEMENTSERVER=-NO-
NETBOOTSERVER=-NO-
NISDOMAIN=-NO-
MACHIPC=-SECURE-
TIMESYNC=-NO-
QTSSERVER=-NO-
WEBSERVER=-NO-
SSHSERVER=-YES-

# Tuning
if [ "${AFPSERVER}" = "-YES-" ] ||
   [ "${QTSSERVER}" = "-YES-" ]; then
  SERVER=-YES-
else
  SERVER=-NO-
fi
