            IODeviceMaster.m,
            NXLock.m,
            IOStubs.m,
            ../EISABus.lksproj/PnPDependentResources.m,
            ../EISABus.lksproj/PnPDeviceResources.m,
            ../EISABus.lksproj/PnPLogicalDevice.m,
            ../EISABus.lksproj/PnPResource.m,
            ../EISABus.lksproj/PnPResources.m,
            ../EISABus.lksproj/pnpDMA.m,
            ../EISABus.lksproj/pnpIOPort.m,
            ../EISABus.lksproj/pnpIRQ.m,
            ../EISABus.lksproj/pnpMemory.m
        );
        H_FILES = (IODeviceMaster.h, NXLock.h);
        OTHER_LINKED = ();
        OTHER_SOURCES = (
            Makefile.preamble,
            Makefile,
            Makefile.postamble
        );
        SUBPROJECTS = ();
    };
    LANGUAGE = English;
    LOCALIZABLE_FILES = {};
    MAKEFILEDIR = "$(MAKEFILEPATH)/pb_makefiles";
    NEXTSTEP_BUILDTOOL = /bin/gnumake;
    NEXTSTEP_INSTALLDIR = /usr/local/bin;
