{
    DYNAMIC_CODE_GEN = YES;
    FILESTABLE = {
        CLASSES = (EISAKernBus.m, EISAKernBus+PlugAndPlay.m, EISAKernBus+PlugAndPlayPrivate.m, EISAKernBusDMAChannel.m, EISAKernBusInterrupt.m, EISAKernBusPortRange.m, EISAResourceDriver.m, PnPArgStack.m, PnPBios.m, PnPDependentResources.m, PnPDeviceResources.m, pnpDMA.m, pnpIOPort.m, pnpIRQ.m, PnPLogicalDevice.m, pnpMemory.m, PnPResource.m, PnPResources.m);
        HEADERSEARCH = (..);
        H_FILES = (bios.h, eisa.h, EISAKernBus.h, EISAKernBus+PlugAndPlay.h, EISAKernBus+PlugAndPlayPrivate.h, EISAKernBusDMAChannel.h, EISAKernBusInterrupt.h, EISAKernBusPortRange.h, EISAResourceDriver.h, PnPArgStack.h, PnPBios.h, PnPDependentResources.h, PnPDeviceResources.h, pnpDMA.h, pnpIOPort.h, pnpIRQ.h, PnPLogicalDevice.h, pnpMemory.h, PnPResource.h, PnPResources.h);
        OTHER_LINKED = (bios.c, eisa.c);
        OTHER_SOURCES = (Makefile, Makefile.preamble);
    };
    LANGUAGE = English;
    LOCALIZABLE_FILES = {};
    MAKEFILEDIR = "$(MAKEFILEPATH)/pb_makefiles";
    NEXTSTEP_BUILDTOOL = /bin/gnumake;
    NEXTSTEP_COMPILEROPTIONS = "-Wno-format -DDRIVER_PRIVATE -static -DKERNEL -D_KERNEL";
    NEXTSTEP_JAVA_COMPILER = /usr/bin/javac;
    NEXTSTEP_OBJCPLUS_COMPILER = /usr/bin/cc;
    PDO_UNIX_BUILDTOOL = $NEXT_ROOT/Developer/bin/make;
    PDO_UNIX_JAVA_COMPILER = "$(NEXTDEV_BIN)/javac";
    PDO_UNIX_OBJCPLUS_COMPILER = "$(NEXTDEV_BIN)/gcc";
    PROJECTNAME = eisa;
    PROJECTTYPE = Component;
    PROJECTVERSION = 2.7;
    WINDOWS_BUILDTOOL = $NEXT_ROOT/Developer/Executables/make;
    WINDOWS_JAVA_COMPILER = "$(JDKBINDIR)/javac.exe";
    WINDOWS_OBJCPLUS_COMPILER = "$(DEVDIR)/gcc";
