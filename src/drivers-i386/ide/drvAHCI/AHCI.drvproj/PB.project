{
    BUNDLE_EXTENSION = config;
    DYNAMIC_CODE_GEN = YES;
    FILESTABLE = {
        OTHER_RESOURCES = (Default.table, Localizable.strings);
        OTHER_SOURCES = (Makefile, Makefile.preamble, DriverInfo);
        SUBPROJECTS = (AHCI.lksproj, PostLoad.tproj);
    };
    LANGUAGE = English;
    LOCALIZABLE_FILES = {
        Localizable.strings = Localizable.strings;
    };
    MAKEFILEDIR = "$(MAKEFILEPATH)/pb_makefiles";
    NEXTSTEP_BUILDTOOL = /bin/gnumake;
    NEXTSTEP_INSTALLDIR = "$(NEXT_ROOT)/private/Drivers";
    PROJECTNAME = AHCI;
    PROJECTTYPE = Driver;
    PROJECTVERSION = 2.6;
}
