{
    BUNDLE_EXTENSION = config;
    DYNAMIC_CODE_GEN = YES;
    FILESTABLE = {
        FRAMEWORKS = (appkit.framework);
        FRAMEWORKSEARCH = ("$(SYSTEM_LIBRARY_DIR)/PrivateFrameworks", /System/Library/PrivateFrameworks);
        OTHER_RESOURCES = (Default.table, DEC21140_100TX.table, DE500_10.table, DE500_100TX.table, EM100_100TX.table, EM110_10.table, EM110_100TX.table, EM110_T4_10.table, EM110_T4_100.table, EM110_T4_BNC.table, SMC9332_10.table, SMC9332_100TX.table, SMC9332B.table, Localizable.strings, DEC21140_100TX.strings, DE500_10.strings, DE500_100TX.strings, EM100_100TX.strings, EM110_10.strings, EM110_100TX.strings, EM110_T4_10.strings, EM110_T4_100.strings, EM110_T4_BNC.strings, SMC9332_10.strings, SMC9332_100TX.strings, SMC9332B.strings, DriverHelp);
        OTHER_SOURCES = (Makefile.preamble, Makefile, Makefile.postamble, m.template, h.template);
        SUBPROJECTS = (DECchip21140.lksproj);
    };
    LANGUAGE = English;
    LOCALIZABLE_FILES = {
        Localizable.strings = Localizable.strings;
    };
    MAKEFILEDIR = "$(MAKEFILEPATH)/pb_makefiles";
    NEXTSTEP_BUILDTOOL = /bin/gnumake;
    NEXTSTEP_INSTALLDIR = "$(NEXT_ROOT)/private/Drivers";
    NEXTSTEP_JAVA_COMPILER = /usr/bin/javac;
    NEXTSTEP_OBJCPLUS_COMPILER = /usr/bin/cc;
    PDO_UNIX_JAVA_COMPILER = "$(NEXTDEV_BIN)/javac";
    PDO_UNIX_OBJCPLUS_COMPILER = "$(NEXTDEV_BIN)/gcc";
    PROJECTNAME = DECchip21140;
    PROJECTTYPE = Driver;
    PROJECTVERSION = 5.00;
    WINDOWS_JAVA_COMPILER = "$(JDKBINDIR)/javac.exe";
    WINDOWS_OBJCPLUS_COMPILER = "$(DEVDIR)/gcc";
}
