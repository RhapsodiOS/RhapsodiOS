{
    BUNDLE_EXTENSION = config;
    DYNAMIC_CODE_GEN = YES;
    FILESTABLE = {
        OTHER_RESOURCES = (Default.table, IntelPRO100PCI.table, Localizable.strings, IntelPRO100PCI.strings, Help);
        OTHER_SOURCES = (Makefile, Makefile.preamble, Makefile.postamble, DriverInfo);
        SUBPROJECTS = (Intel82556.lksproj);
    };
    LANGUAGE = English;
    LOCALIZABLE_FILES = {
        Localizable.strings = Localizable.strings;
        IntelPRO100PCI.strings = IntelPRO100PCI.strings;
        Help = Help;
    };
    MAKEFILEDIR = "$(MAKEFILEPATH)/pb_makefiles";
    NEXTSTEP_BUILDTOOL = /bin/gnumake;
    NEXTSTEP_INSTALLDIR = "$(NEXT_ROOT)/private/Drivers";
    PROJECTNAME = Intel82556NetworkDriver;
    PROJECTTYPE = Driver;
    PROJECTVERSION = 2.6;
}
