HOST_CC ?= cc
HOST_CFLAGS ?= -std=c89 -pedantic -Wall -Wextra -Werror
HOST_CPPFLAGS ?= -D__ppc__

mpic_direct_test: mpic_direct_test.c ../powermac/chips/mpic.c
	$(HOST_CC) $(HOST_CFLAGS) -DMPIC_DIRECT_HOST_TEST \
	    -I../powermac -o $@ mpic_direct_test.c ../powermac/chips/mpic.c

pe_keylargo_test: pe_keylargo_test.c ../powermac/chips/keylargo_audio.c
	$(HOST_CC) $(HOST_CFLAGS) \
	    -Wno-import-preprocessor-directive-pedantic $(HOST_CPPFLAGS) \
	    -I../../../../kernel-7 \
	    -o $@ pe_keylargo_test.c ../powermac/chips/keylargo_audio.c

interrupt_depth_test: interrupt_depth_test.c
	$(HOST_CC) $(HOST_CFLAGS) -o $@ interrupt_depth_test.c

pe_davbus_test: pe_davbus_test.c ../powermac/chips/davbus_audio.c \
    ../powermac/chips/davbus_audio.h ../../../../kernel-7/machdep/ppc/PEDAVBus.h
	$(HOST_CC) $(HOST_CFLAGS) $(HOST_CPPFLAGS) -I../../../../kernel-7 \
	    -o $@ pe_davbus_test.c ../powermac/chips/davbus_audio.c

keylargo_discovery_test: keylargo_discovery_test.c ../powermac/chips/keylargo_model.h \
    ../powermac/chips/keylargo_discovery.h
	$(HOST_CC) $(HOST_CFLAGS) -o $@ keylargo_discovery_test.c

davbus_binding_test: davbus_binding_test.c ../powermac/chips/keylargo.c \
    ../powermac/chips/davbus_audio.c ../powermac/chips/davbus_audio.h \
    ../../../../kernel-7/machdep/ppc/PEDAVBus.h
	$(HOST_CC) $(HOST_CFLAGS) $(HOST_CPPFLAGS) -I../../../../kernel-7 \
	    -o $@ davbus_binding_test.c ../powermac/chips/davbus_audio.c

test: mpic_direct_test pe_keylargo_test pe_davbus_test interrupt_depth_test \
    keylargo_discovery_test davbus_binding_test
	./mpic_direct_test
	./pe_keylargo_test
	./pe_davbus_test
	./interrupt_depth_test
	./keylargo_discovery_test
	./davbus_binding_test

clean:
	rm -f mpic_direct_test pe_keylargo_test pe_davbus_test interrupt_depth_test \
	    keylargo_discovery_test davbus_binding_test
