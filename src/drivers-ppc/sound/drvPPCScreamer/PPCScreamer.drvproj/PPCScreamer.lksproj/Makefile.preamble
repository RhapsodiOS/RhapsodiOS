INCLUDED_ARCHS = ppc
USE_MACH_USER = NO
vpath %.c $(SRCROOT)/../drvPPCTASAudio/PPCTASAudio.drvproj/PPCTASAudio.lksproj

OTHER_PRIVATE_HEADERS := $(PUBLIC_HEADERS)
PUBLIC_HEADERS =

VERSION_DIR = Versions/B
SYSTEM_VERS_FRAMEWORK = $(SYSTEM_FRAMEWORK)/$(VERSION_DIR)
SYSTEM_VERS_HEADERS = $(SYSTEM_VERS_FRAMEWORK)/Headers
KERNEL_VERS_HEADERS = $(SYSTEM_VERS_FRAMEWORK)/PrivateHeaders
PUBLIC_HDR_INSTALLDIR = $(SYSTEM_VERS_HEADERS)/bsd/dev
PRIVATE_HDR_INSTALLDIR = $(KERNEL_VERS_HEADERS)/bsd/dev
OTHER_CFLAGS = -UMACH_USER_API -DKERNEL_PRIVATE -DDRIVER_PRIVATE -I$(NEXT_ROOT)$(SYSTEM_LIBRARY_DIR)/Frameworks/System.framework/PrivateHeaders/machdep \
              -I$(SRCROOT)/../drvPPCTASAudio/PPCTASAudio.drvproj/PPCTASAudio.lksproj
