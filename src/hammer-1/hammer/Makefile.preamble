# Shared sources live in ../common; HAMMER headers come from kernel-hdrs.
# Phase 1 built the offline show/blockmap/checkmap commands, phase 2 adds
# synctid and history; the other cmd_*.c files return as later phases
# bring them back.
OTHER_CFLAGS = -Wno-precomp -I../common -I$(NEXT_ROOT)/System/Library/Frameworks/System.framework/Versions/B/Headers/bsd/hammer
INSTALL_AS_USER = root
INSTALL_AS_GROUP = wheel
INSTALL_PERMISSIONS = 0755
