ninja_required_version = 1.9
builddir = BUILD.ninja/DEBUG_UNIVERSAL
outdir = BUILD.ninja/DEBUG_UNIVERSAL
i386_outdir = BUILD.ninja/DEBUG_I386
ppc_outdir = BUILD.ninja/DEBUG_PPC
i386_manifest = build-debug.ninja
ppc_manifest = build-ppc-debug.ninja
include ninja/universal.ninja
default BUILD.ninja/DEBUG_UNIVERSAL/mach_kernel BUILD.ninja/DEBUG_UNIVERSAL/mach_kernel.sys
