library_dir = $next_root/usr/local/lib
driver_object = $library_dir/$driver_library
objc_object = $library_dir/libkobjc.o
pexpert_object = $library_dir/$pexpert_library
link_objects = $libc_objects $kernel_objects $outdir/subr_prof.o $outdir/ioconf.o $driver_object $objc_object $pexpert_object $mach_user_objects $outdir/vers.o

rule version
  command = cd $outdir && rm -f version.stamp && /bin/sh -e ../../conf/tools/newvers/newvers.csh $$(cat ../../conf/version.major ../../conf/version.minor ../../conf/version.variant) && test -s vers.c && test -s vers.suffix && touch version.stamp
  description = VERSION $config

rule version_cc
  command = cd $outdir && $kcc $includes $machine_cflags -c vers.c -o vers.o
  description = CC $out

rule link_kernel
  command = ld -static $ldflags $link_objects -lcc -o $out && size $out && chmod 755 $out
  description = LD $out

# Historical strip backdates its output by five seconds.
rule strip_kernel
  command = strip -x -o $out $in && chmod +w $in && touch $out
  description = STRIP $out

build $outdir/vers.c $outdir/vers.suffix | $outdir/version.stamp: version objects $
  $driver_object $objc_object $pexpert_object /usr/lib/libcc.a $
  conf/version.major conf/version.minor conf/version.variant $
  conf/tools/newvers/newvers.csh ninja/kernel.ninja ninja/common.ninja $
  $architecture_manifest $release_manifest $debug_manifest
build $outdir/vers.o: version_cc $outdir/vers.c || $outdir/prepared $outdir/validated
build $outdir/mach_kernel.sys: link_kernel objects $outdir/vers.o $
  $driver_object $objc_object $pexpert_object /usr/lib/libcc.a | ninja/kernel.ninja
build $outdir/mach_kernel: strip_kernel $outdir/mach_kernel.sys
