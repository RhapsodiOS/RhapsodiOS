  source = ../../machdep/i386/libc/pagesize.c
  object = pagesize.o
  flags = $cppflags $machine_cflags -O4

build $outdir/strchr.o: cc machdep/i386/libc/strchr.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/strchr.c
  object = strchr.o
  flags = $cppflags $machine_cflags -O4 -funroll-all-loops

build $outdir/strrchr.o: cc machdep/i386/libc/strrchr.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/strrchr.c
  object = strrchr.o
  flags = $cppflags $machine_cflags -O4 -funroll-all-loops

build $outdir/strlen.o: cc machdep/i386/libc/strlen.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/strlen.c
  object = strlen.o
  flags = $cppflags $machine_cflags -O4 -funroll-all-loops

build $outdir/strcpy.o: cc machdep/i386/libc/strcpy.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/strcpy.c
  object = strcpy.o
  flags = $cppflags $machine_cflags -O4 -funroll-all-loops

build $outdir/strncpy.o: cc machdep/i386/libc/strncpy.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/strncpy.c
  object = strncpy.o
  flags = $cppflags $machine_cflags -O4 -funroll-all-loops

build $outdir/strcat.o: cc machdep/i386/libc/strcat.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/strcat.c
  object = strcat.o
  flags = $cppflags $machine_cflags -O4 -funroll-all-loops

build $outdir/strncat.o: cc machdep/i386/libc/strncat.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/strncat.c
  object = strncat.o
  flags = $cppflags $machine_cflags -O4 -funroll-all-loops

build $outdir/strcmp.o: cc machdep/i386/libc/strcmp.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/strcmp.c
  object = strcmp.o
  flags = $cppflags $machine_cflags -O4 -funroll-all-loops

build $outdir/strncmp.o: cc machdep/i386/libc/strncmp.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/strncmp.c
  object = strncmp.o
