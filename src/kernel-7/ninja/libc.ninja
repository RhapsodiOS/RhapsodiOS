# i386 libc exceptions from conf/Makefile.i386.

build $outdir/memchr.o: cc machdep/i386/libc/memchr.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/memchr.c
  object = memchr.o
  flags = $cppflags $machine_cflags -O4

build $outdir/memcmp.o: cc machdep/i386/libc/memcmp.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/memcmp.c
  object = memcmp.o
  flags = $cppflags $machine_cflags -O4

build $outdir/memcpy.o: cc machdep/i386/libc/memcpy.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/memcpy.c
  object = memcpy.o
  flags = $cppflags $machine_cflags -O4

build $outdir/memmove.o: cc machdep/i386/libc/memmove.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/memmove.c
  object = memmove.o
  flags = $cppflags $machine_cflags -O4

build $outdir/memset.o: cc machdep/i386/libc/memset.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/memset.c
  object = memset.o
