  object = index.o
  flags = $cppflags $machine_cflags -O4 -funroll-all-loops

build $outdir/ffs.o: cc machdep/i386/libc/ffs.c || $outdir/prepared $outdir/validated generated
  source = ../../machdep/i386/libc/ffs.c
  object = ffs.o
  flags = $cppflags $machine_cflags -O4 -funroll-all-loops

libc_objects = $outdir/memchr.o $outdir/memcmp.o $outdir/memcpy.o $outdir/memmove.o $outdir/memset.o $outdir/pagesize.o $outdir/strchr.o $outdir/strrchr.o $outdir/strlen.o $outdir/strcpy.o $outdir/strncpy.o $outdir/strcat.o $outdir/strncat.o $outdir/strcmp.o $outdir/strncmp.o $outdir/index.o $outdir/ffs.o

build libc: phony $outdir/memchr.o $outdir/memcmp.o $outdir/memcpy.o $outdir/memmove.o $outdir/memset.o $outdir/pagesize.o $outdir/strchr.o $outdir/strrchr.o $outdir/strlen.o $outdir/strcpy.o $outdir/strncpy.o $outdir/strcat.o $outdir/strncat.o $outdir/strcmp.o $outdir/strncmp.o $outdir/index.o $outdir/ffs.o
