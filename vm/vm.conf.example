# Copy to vm.conf (gitignored). Local Rhapsody guest over hecnet/VMnet8.

Host=10.10.0.241
User=root
Password=abc123
RemoteRoot=/build
# LocalRoot=   (empty = parent directory of vm/)
Plink=plink.exe
Pscp=pscp.exe
# OpenSSH tools used by sync-src.ps1 / build-src.ps1 (legacy crypto to the PPC guest)
Ssh=ssh.exe
Tar=tar.exe
Make=gnumake
RepoDir=/build/repo
BuiltDir=/build/built
ToolsDir=/build/tools
BootstrapRoot=/build/bootstrap-root
StateDir=/build/state
ToolchainProfile=rbuild-1/toolchains/gcc-darwin-ppc.conf
SyncPaths=src
