# Copy to vm.conf (gitignored). Local Rhapsody guest over hecnet/VMnet8.

Host=10.10.0.241
# SSH port; a QEMU user-network guest uses its host forward (e.g. 127.0.0.1, 2222).
Port=22
User=root
Password=abc123
RemoteRoot=/build
# LocalRoot=   (empty = parent directory of vm/)
Plink=plink.exe
Pscp=pscp.exe
# OpenSSH tools used by sync-src.ps1 / build-src.ps1 (legacy crypto to the PPC guest)
Ssh=ssh.exe
Tar=tar.exe
Make=gnumake
RepoDir=/build/repo
BuiltDir=/build/built
ToolsDir=/build/tools
BootstrapRoot=/build/bootstrap-root
StateDir=/build/state
# Which CPU -Kernel/-KernelDrivers build: gcc-darwin-ppc.conf, gcc-darwin-i386.conf,
# or gcc-darwin-universal.conf (i386, then ppc). See vm/README.md.
ToolchainProfile=rbuild-1/toolchains/gcc-darwin-ppc.conf
SyncPaths=src
